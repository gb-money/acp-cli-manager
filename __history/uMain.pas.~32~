unit uMain;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  System.Generics.Collections, System.NetEncoding, System.IOUtils,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs, FMX.WebBrowser,
  uAgent, uGeminiAgent, uSessionManager, FMX.StdCtrls,
  FMX.Controls.Presentation, FMX.MultiView, FMX.Ani, System.Skia, FMX.Skia,
  FMX.Objects;

type
  TAgentType = (atGemini, atClaude, atCodex);

  TAgentTypeHelper = record helper for TAgentType
    function ToString: string;
    function AgentClass: TComponentClass;
  end;

  TS = class(TForm)
    FloatAnimSidebar: TFloatAnimation;
    Panel2: TPanel;
    Button2: TButton;
    SkSvg1: TSkSvg;
    RectSidebar: TRectangle;
    RectBtnHamburger: TRectangle;
    RectSidebarHeader: TRectangle;
    RectBtnNewChat: TRectangle;
    SBtnNewChat: TSpeedButton;
    SkSvg2: TSkSvg;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormShow(Sender: TObject);
    procedure RectBtnHamburgerClick(Sender: TObject);
  private
    FSessionMgr: TSessionManager;
    FAgents: TDictionary<TAgentType, TAgent>;
    FActiveSession: TSessionInfo;
    FInitialized: Boolean;
    FSidebarExpanded: Boolean;
    procedure DoStatusChange(Sender: TObject; const Msg: string);
    procedure DoResponse(Sender: TObject; const SessionId, Text: string);
    procedure SetSidebarExpanded(const Value: Boolean);
  public
    property SidebarExpanded: Boolean read FSidebarExpanded write SetSidebarExpanded default True;
  end;

var
  S: TS;

implementation

{$R *.fmx}

{ TAgentTypeHelper }
function TAgentTypeHelper.AgentClass: TComponentClass;
begin
  case Self of atGemini: Result := TGeminiAgent; else Result := nil; end;
end;
function TAgentTypeHelper.ToString: string;
begin
  case Self of atGemini: Result := 'Gemini'; atClaude: Result := 'Claude'; atCodex: Result := 'Codex'; else Result := ''; end;
end;

{ TS }

procedure TS.SetSidebarExpanded(const Value: Boolean);
const
  ExpandedWidth = 225;
  CollapsedWidth = 65;
begin
  FSidebarExpanded := Value;
  FloatAnimSidebar.Stop;

  FloatAnimSidebar.StartValue := RectSidebar.Width;
  if FSidebarExpanded then
    FloatAnimSidebar.StopValue := ExpandedWidth
  else
    FloatAnimSidebar.StopValue := CollapsedWidth;

  FloatAnimSidebar.Start;
end;

procedure TS.FormCreate(Sender: TObject);
begin
  FInitialized := False;
  FAgents := TDictionary<TAgentType, TAgent>.Create;
  FSessionMgr := TSessionManager.Create;
end;

procedure TS.FormShow(Sender: TObject);
begin
  if not FInitialized then
  begin
    FInitialized := True;
    FSidebarExpanded := True;
  end;
end;

procedure TS.RectBtnHamburgerClick(Sender: TObject);
begin
  SidebarExpanded := not SidebarExpanded;
end;

procedure TS.DoResponse(Sender: TObject; const SessionId, Text: string);
begin
  if Assigned(FActiveSession) and (FActiveSession.SessionId = SessionId) then
end;

procedure TS.DoStatusChange(Sender: TObject; const Msg: string); begin end;


procedure TS.FormClose(Sender: TObject; var Action: TCloseAction);
var Agent: TAgent;
begin
  FSessionMgr.Free;
  for Agent in FAgents.Values do Agent.Free;
  FAgents.Free;
end;

end.
